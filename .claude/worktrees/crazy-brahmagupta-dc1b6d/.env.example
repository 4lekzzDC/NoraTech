# Credenciais do projeto Supabase (anon key — pública, segura no frontend)
# Pegue em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# E-mail do administrador do painel /admin (opcional).
# Quando informado, esse usuário tem acesso ao painel mesmo sem a coluna
# `role = 'admin'` na tabela `profiles`. A política RLS continua usando
# `role`, então também rode o supabase/admin_schema.sql e marque seu usuário
# com `role = 'admin'` para ter permissão de escrita.
VITE_ADMIN_EMAIL=admin@noratech.com.br
