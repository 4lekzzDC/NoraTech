# Credenciais do projeto Supabase (anon key — pública, segura no frontend)
# Pegue em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# E-mail do administrador do painel /admin (opcional).
# Quando informado, esse usuário tem acesso ao painel mesmo sem a coluna
# `role = 'admin'` na tabela `profiles`. A política RLS continua usando
# `role`, então também rode o supabase/admin_schema.sql e marque seu usuário
# com `role = 'admin'` para ter permissão de escrita.
VITE_ADMIN_EMAIL=admin@noratech.com.br

# Stripe — chave PUBLICÁVEL (pk_test_... ou pk_live_...), segura no navegador.
# A chave SECRETA nunca vai em .env — é um segredo das Edge Functions
# (Supabase Dashboard → Edge Functions → Secrets: STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# NoraDocs — Google Drive (OAuth com escopo `drive.file`, nunca o escopo
# amplo — ver docs/noradocs/integracao-google.md).
#
# Client ID do OAuth — NÃO é segredo, é o identificador público do app.
# O Client Secret NUNCA vai em .env nem no repositório: é configurado como
# secret das Edge Functions noradocs-google-oauth e noradocs-drive
# (Supabase Dashboard → Edge Functions → Secrets: GOOGLE_OAUTH_CLIENT_ID,
# GOOGLE_OAUTH_CLIENT_SECRET).
VITE_GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Chave de API do Google Picker — pública, mas restrita por HTTP referrer no
# Google Cloud Console às origens do NoraTech (produção e localhost). É uma
# credencial "API key", diferente do Client ID/Secret do OAuth.
VITE_GOOGLE_PICKER_API_KEY=AIzaSy...
